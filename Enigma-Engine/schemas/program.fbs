// Schema for ProgramSnapshot — persistent analysis state only.
// No transient runtime objects. No binary bytes.

namespace fbschema;

table AddressRange {
    space: string;
    offset: ulong;
    length: ulong;
}

table MemoryBlock {
    name: string;
    comment: string;
    start_address: ulong;
    length: ulong;
    permissions: string;
    block_type: string;
    bytes: [ubyte];
}

table CodeUnit {
    address: ulong;
    length: ushort;
    unit_type: string;
    data_type_name: string;
    flow_override: string;
    // --- appended (schema v1 additions; all optional) ---
    mnemonic: string;
    data_type_id: ulong = 0;
    data_length: int = 0;
}

table FunctionRecord {
    name: string;
    entry_point: ulong;
    body_ranges: [AddressRange];
    calling_convention: string;
    return_type: string;
    return_type_id: ulong = 0;
    stack_frame_size: ulong;
    is_external: bool = false;
    has_no_return: bool = false;
    is_inline: bool = false;
    call_fixup: string;
    signature_source: ubyte = 0;
    comment: string;
    params: [ParamRecord];
    // --- appended ---
    thunk: bool = false;
    thunked_function: ulong = 0;
    locals: [LocalVarRecord];
}

table ParamRecord {
    name: string;
    data_type_name: string;
    data_type_id: ulong = 0;
    ordinal: int = -1;
    // --- appended ---
    // Compact storage form: "u" | "reg:<offset>:<size>" |
    // "stack:<signedOffset>:<size>" | "mem:<offset>:<size>".
    storage: string;
}

table LocalVarRecord {
    name: string;
    data_type_id: ulong = 0;
    first_use_offset: int = 0;
    storage: string;
}

table SymbolRecord {
    name: string;
    parent_namespace: string;
    address: ulong;
    symbol_type: string;
    is_primary: bool = false;
    symbol_source: int = 0;
}

table CommentRecord {
    address: ulong;
    comment_type: string;
    text: string;
}

table ReferenceRecord {
    from_address: ulong;
    to_address: ulong;
    ref_type: string;
    is_primary: bool = false;
    // --- appended ---
    op_index: int = -1;
    ref_type_code: byte = 0;
    source: byte = 0;
    kind: byte = 0;             // 0=memory 1=stack 2=register 3=external
    to_space: string;           // register / EXTERNAL
    stack_offset: int = 0;
    external_library: string;
    external_label: string;
}

table StructField {
    name: string;
    offset: int;
    data_type_id: ulong;
    // --- appended ---
    size: int = 0;
    comment: string;
    bit_offset: int = -1;
    bit_size: int = -1;
    bit_base_id: ulong = 0;
    byte_width: int = 0;
}

table EnumValue {
    name: string;
    value: long;
    // --- appended ---
    comment: string;
}

table DataTypeRecord {
    dt_id: ulong;
    name: string;
    category_path: string;
    size: int;
    type_kind: string;
    description: string;
    // Composite types
    fields: [StructField];
    enum_values: [EnumValue];
    // Pointer target type ID
    pointer_target_id: ulong = 0;
    // Array info
    array_element_id: ulong = 0;
    array_element_count: int = 0;
    // Typedef base type ID
    typedef_base_id: ulong = 0;
    // --- appended ---
    pack: int = -1;
    min_alignment: int = 0;
    // True for unregistered helper types the writer materialized inline
    // (e.g. a typedef's internal pointer base).  The reader rebuilds them
    // for reference resolution but must not list them as program types.
    inline_materialized: bool = false;
    // Function definitions: trailing varargs ("...") marker.
    funcdef_varargs: bool = false;
}

table BookmarkRecord {
    address: ulong;
    category: string;
    text: string;
    type: string;
}

table EquateRecord {
    name: string;
    address: ulong;
    op_index: int;
    value: long;
}

table ExternalLocationRecord {
    name: string;
    original_import_name: string;
    library_name: string;
    address: ulong;
}

table RelocationRecord {
    address: ulong;
    type: string;
    value: long;
    bytes: [ubyte];
    // --- appended ---
    status: byte = 0;
    values: [long];
    symbol_name: string;
}

table SourceMapEntryRecord {
    address: ulong;
    source_file_path: string;
    line_number: int;
    length: ulong;
}

table FunctionTagRecord {
    name: string;
    comment: string;
    function_addresses: [ulong];
}

table PropertyRecord {
    name: string;
    value: string;
}

table ProgramContextRecord {
    register_name: string;
    address: ulong;
    value: string;
    // --- appended ---
    end_address: ulong = 0;
    mask: [ubyte];
    is_default: bool = false;
    register_offset: long = 0;
}

table MetadataRecord {
    key: string;
    value: string;
}

table TreeRecord {
    name: string;
    modification_number: ulong;
}

table TreeModuleRecord {
    tree_name: string;
    id: long;
    name: string;
    comment: string;
}

table TreeFragmentRecord {
    tree_name: string;
    id: long;
    name: string;
    comment: string;
}

table TreeRelationshipRecord {
    tree_name: string;
    parent_id: long;
    child_id: long;
    child_index: int;
}

table TreeFragmentRangeRecord {
    tree_name: string;
    fragment_id: long;
    start: ulong;
    end: ulong;
}

table CallingConventionRecord {
    name: string;
}

table SizeAlignmentEntry {
    size: int;
    alignment: int;
}

table DataOrgRecord {
    pointer_size: int = 8;
    machine_alignment: int = 8;
    use_ms_convention: bool = false;
    size_alignments: [SizeAlignmentEntry];
}

table ProgramSnapshot {
    schema_version: int = 1;
    binary_name: string;
    binary_sha256: string;
    language_id: string;
    compiler_spec_id: string;
    image_base: ulong;
    min_address: ulong;
    max_address: ulong;
    creation_timestamp: ulong;
    is_big_endian: bool = false;

    memory_blocks: [MemoryBlock];
    code_units: [CodeUnit];
    functions: [FunctionRecord];
    calling_conventions: [CallingConventionRecord];
    symbols: [SymbolRecord];
    comments: [CommentRecord];
    references: [ReferenceRecord];
    data_types: [DataTypeRecord];
    bookmarks: [BookmarkRecord];
    equates: [EquateRecord];
    external_locations: [ExternalLocationRecord];
    relocations: [RelocationRecord];
    source_map_entries: [SourceMapEntryRecord];
    function_tags: [FunctionTagRecord];
    user_properties: [PropertyRecord];
    program_context: [ProgramContextRecord];
    // --- appended ---
    metadata: [MetadataRecord];
    trees: [TreeRecord];
    tree_modules: [TreeModuleRecord];
    tree_fragments: [TreeFragmentRecord];
    tree_relationships: [TreeRelationshipRecord];
    tree_fragment_ranges: [TreeFragmentRangeRecord];
    // --- appended (P3j) ---
    entry_points: [ulong];
    // All registered source files (files with no map entries included).
    source_files: [string];
    // Data organization settings (pointer size, machine alignment, MS
    // bitfield convention, size-alignment table).
    data_org: DataOrgRecord;
}

root_type ProgramSnapshot;
